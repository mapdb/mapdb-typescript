{
  "name": "@mapdb/typescript",
  "version": "0.2.0",
  "description": "High-performance primitive collections and lazy stream pipelines for TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./object": {
      "types": "./dist/object/index.d.ts",
      "import": "./dist/object/index.js"
    },
    "./object/*": {
      "types": "./dist/object/*.d.ts",
      "import": "./dist/object/*.js"
    },
    "./stream": {
      "types": "./dist/stream/stream.d.ts",
      "import": "./dist/stream/stream.js"
    },
    "./multimap/*": {
      "types": "./dist/multimap/*.d.ts",
      "import": "./dist/multimap/*.js"
    },
    "./treebag/*": {
      "types": "./dist/treebag/*.d.ts",
      "import": "./dist/treebag/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./arraylist/*": {
      "types": "./dist/arraylist/*.d.ts",
      "import": "./dist/arraylist/*.js"
    },
    "./bag/*": {
      "types": "./dist/bag/*.d.ts",
      "import": "./dist/bag/*.js"
    },
    "./bitset/*": {
      "types": "./dist/bitset/*.d.ts",
      "import": "./dist/bitset/*.js"
    },
    "./deque/*": {
      "types": "./dist/deque/*.d.ts",
      "import": "./dist/deque/*.js"
    },
    "./hashmap/*": {
      "types": "./dist/hashmap/*.d.ts",
      "import": "./dist/hashmap/*.js"
    },
    "./hashset/*": {
      "types": "./dist/hashset/*.d.ts",
      "import": "./dist/hashset/*.js"
    },
    "./interval/*": {
      "types": "./dist/interval/*.d.ts",
      "import": "./dist/interval/*.js"
    },
    "./priority_queue/*": {
      "types": "./dist/priority_queue/*.d.ts",
      "import": "./dist/priority_queue/*.js"
    },
    "./stack/*": {
      "types": "./dist/stack/*.d.ts",
      "import": "./dist/stack/*.js"
    },
    "./treemap/*": {
      "types": "./dist/treemap/*.d.ts",
      "import": "./dist/treemap/*.js"
    },
    "./treeset/*": {
      "types": "./dist/treeset/*.d.ts",
      "import": "./dist/treeset/*.js"
    },
    "./tuple/*": {
      "types": "./dist/tuple/*.d.ts",
      "import": "./dist/tuple/*.js"
    },
    "./typed/*": {
      "types": "./dist/typed/*.d.ts",
      "import": "./dist/typed/*.js"
    },
    "./typed/arraylist/*": {
      "types": "./dist/typed/arraylist/*.d.ts",
      "import": "./dist/typed/arraylist/*.js"
    },
    "./typed/bag/*": {
      "types": "./dist/typed/bag/*.d.ts",
      "import": "./dist/typed/bag/*.js"
    },
    "./typed/hashmap/*": {
      "types": "./dist/typed/hashmap/*.d.ts",
      "import": "./dist/typed/hashmap/*.js"
    },
    "./typed/hashset/*": {
      "types": "./dist/typed/hashset/*.d.ts",
      "import": "./dist/typed/hashset/*.js"
    },
    "./typed/stack/*": {
      "types": "./dist/typed/stack/*.d.ts",
      "import": "./dist/typed/stack/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-EPL-1.0.txt",
    "LICENSE-EDL-1.0.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npx vitest run",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --write src/",
    "generate": "node src/codegen/generate.mjs",
    "generate:typed-hashmap": "node src/codegen/generate.mjs --family hashmap",
    "generate:typed-arraylist": "node src/codegen/generate.mjs --family arraylist",
    "generate:typed-hashset": "node src/codegen/generate.mjs --family hashset",
    "generate:typed-stack": "node src/codegen/generate.mjs --family stack",
    "generate:typed-bag": "node src/codegen/generate.mjs --family bag",
    "generate:hashmap-nontyped": "node src/codegen/generate.mjs --family hashmap-nontyped",
    "generate:multimap-nontyped": "node src/codegen/generate.mjs --family multimap-nontyped",
    "generate:check": "node src/codegen/generate.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "collections",
    "hashmap",
    "arraylist",
    "stream",
    "eclipse-collections",
    "primitive"
  ],
  "license": "EPL-1.0"
}
